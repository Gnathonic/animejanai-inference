#version 450
layout(local_size_x = 32, local_size_y = 8) in;
layout(binding = 0) readonly  buffer Src   { float src[]; };
layout(binding = 1) readonly  buffer Start { float startf[]; };
layout(binding = 2) readonly  buffer Wt    { float wt[]; };
layout(binding = 3) writeonly buffer Dst   { float dst[]; };
layout(push_constant) uniform parameter { int W; int H; int taps; int ch; } p;
int mirr(int i, int n){ i = i<0 ? -i-1 : i; i = i>=n ? 2*n-1-i : i; return clamp(i,0,n-1); }
void main(){
    int x = int(gl_GlobalInvocationID.x), y = int(gl_GlobalInvocationID.y);
    if (x >= p.W || y >= p.H) return;
    int s0 = int(startf[y]); float a = 0.0;
    for (int j = 0; j < p.taps; j++){ float wj = wt[y*p.taps + j]; int s = mirr(s0+j, p.ch);
        a += wj * src[s*p.W + x]; }
    dst[y*p.W + x] = a;
}
