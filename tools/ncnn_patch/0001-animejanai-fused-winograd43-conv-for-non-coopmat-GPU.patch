new file mode 100644
index 0000000..371d4f5
--- /dev/null
+++ b/src/layer/spabtail.h
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// SpabTail: fused tail of a SPAN "SPAB" block
+//   out = (res + x) * tanh(W_att * x + b_att)      (W_att = 1x1 convolution, num_input -> num_output)
+// Replaces Split / BinaryOp(add) / Convolution 1x1 / TanH / BinaryOp(mul) — five memory-bound passes —
+// with one pass (the elementwise chain is VRAM-bandwidth bound on large feature maps).
+//   bottom[0] = res (residual input), bottom[1] = x (the block's conv3 output)
+//   param: 0=num_output 1=num_input 2=bias_term 3=weight_data_size ; model: weights (as Convolution), bias
+
+#ifndef LAYER_SPABTAIL_H
+#define LAYER_SPABTAIL_H
+
+#include "layer.h"
+
+namespace ncnn {
+
+class SpabTail : public Layer
+{
+public:
+    SpabTail();
+
+    virtual int load_param(const ParamDict& pd);
+    virtual int load_model(const ModelBin& mb);
+
+    virtual int forward(const std::vector<Mat>& bottom_blobs, std::vector<Mat>& top_blobs, const Option& opt) const;
+
+public:
+    int num_output;
+    int num_input;
+    int bias_term;
+    int weight_data_size;
+
+    Mat weight_data;   // [num_output][num_input]
+    Mat bias_data;
+};
+
+} // namespace ncnn
+
+#endif // LAYER_SPABTAIL_H
