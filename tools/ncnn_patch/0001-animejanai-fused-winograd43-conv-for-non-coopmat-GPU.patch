diff --git a/src/layer/spabtail.cpp b/src/layer/spabtail.cpp
new file mode 100644
index 0000000..fe0f766
--- /dev/null
+++ b/src/layer/spabtail.cpp
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include "spabtail.h"
+
+#include <math.h>
+
+namespace ncnn {
+
+SpabTail::SpabTail()
+{
+    one_blob_only = false;
+    support_inplace = false;
+    support_packing = false;   // CPU reference path works on elempack 1
+}
+
+int SpabTail::load_param(const ParamDict& pd)
+{
+    num_output = pd.get(0, 0);
+    num_input = pd.get(1, 0);
+    bias_term = pd.get(2, 0);
+    weight_data_size = pd.get(3, 0);
+    if (num_output <= 0 || num_input <= 0 || weight_data_size != num_output * num_input)
+        return -1;
+    return 0;
+}
+
+int SpabTail::load_model(const ModelBin& mb)
+{
+    weight_data = mb.load(weight_data_size, 0);
+    if (weight_data.empty())
+        return -100;
+
+    if (bias_term)
+    {
+        bias_data = mb.load(num_output, 1);
+        if (bias_data.empty())
+            return -100;
+    }
+
+    return 0;
+}
+
+int SpabTail::forward(const std::vector<Mat>& bottom_blobs, std::vector<Mat>& top_blobs, const Option& opt) const
+{
+    const Mat& res = bottom_blobs[0];
+    const Mat& x = bottom_blobs[1];
+    if (x.dims != 3 || x.c != num_input || res.c != num_output || res.w != x.w || res.h != x.h)
+        return -1;
+
+    Mat& top_blob = top_blobs[0];
+    top_blob.create(x.w, x.h, num_output, x.elemsize, opt.blob_allocator);
+    if (top_blob.empty())
+        return -100;
+
+    const int size = x.w * x.h;
+
+    #pragma omp parallel for num_threads(opt.num_threads)
+    for (int o = 0; o < num_output; o++)
+    {
+        const float* w = (const float*)weight_data + o * num_input;
+        const float b = bias_term ? bias_data[o] : 0.f;
+        const float* r = res.channel(o);
+        const float* xo = x.channel(o);
+        float* out = top_blob.channel(o);
+        for (int i = 0; i < size; i++)
+        {
+            float att = b;
+            for (int q = 0; q < num_input; q++)
+                att += w[q] * x.channel(q)[i];
+            out[i] = (r[i] + xo[i]) * tanhf(att);
+        }
+    }
+
+    return 0;
+}
+
+} // namespace ncnn
