diff --git a/src/layer/vulkan/gridsample_vulkan.cpp b/src/layer/vulkan/gridsample_vulkan.cpp
new file mode 100644
index 0000000..b788689
--- /dev/null
+++ b/src/layer/vulkan/gridsample_vulkan.cpp
@@ -0,0 +1,95 @@
+// Copyright 2026 Tencent
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include "gridsample_vulkan.h"
+
+#include "layer_shader_type.h"
+
+namespace ncnn {
+
+GridSample_vulkan::GridSample_vulkan()
+{
+    support_vulkan = true;
+    support_vulkan_packing = false; // operate on unpacked elempack=1 buffers (ncnn inserts Packing)
+
+    pipeline_gridsample = 0;
+}
+
+int GridSample_vulkan::create_pipeline(const Option& opt)
+{
+    // only the mode params are baked as specialization constants; all shapes go
+    // through push constants (psc -> p.x when the spec const is 0), so a single
+    // pipeline serves every (dynamic) resolution.
+    std::vector<vk_specialization_type> specializations(4 + 9);
+    specializations[0].i = sample_type;
+    specializations[1].i = padding_mode;
+    specializations[2].i = align_corner;
+    specializations[3].i = permute_fusion;
+    // shape specialization constants left 0 so psc() falls through to push
+    // constants -> a single pipeline serves every (dynamic) resolution.
+    for (int k = 0; k < 9; k++)
+        specializations[4 + k].i = 0;
+
+    pipeline_gridsample = new Pipeline(vkdev);
+    pipeline_gridsample->set_optimal_local_size_xyz(8, 8, 1);
+    pipeline_gridsample->create(LayerShaderType::gridsample, opt, specializations);
+
+    return 0;
+}
+
+int GridSample_vulkan::destroy_pipeline(const Option& /*opt*/)
+{
+    delete pipeline_gridsample;
+    pipeline_gridsample = 0;
+
+    return 0;
+}
+
+int GridSample_vulkan::forward(const std::vector<VkMat>& bottom_blobs, std::vector<VkMat>& top_blobs, VkCompute& cmd, const Option& opt) const
+{
+    const VkMat& bottom_blob = bottom_blobs[0]; // image  [w, h, c]
+    const VkMat& grid = bottom_blobs[1];        // grid
+
+    size_t elemsize = bottom_blob.elemsize;
+    int channels = bottom_blob.c;
+
+    // output spatial dims follow the grid layout (mirrors the CPU layer)
+    int outw, outh;
+    if (permute_fusion == 0)
+    {
+        outw = grid.h;
+        outh = grid.c;
+    }
+    else
+    {
+        outw = grid.w;
+        outh = grid.h;
+    }
+
+    VkMat& top_blob = top_blobs[0];
+    top_blob.create(outw, outh, channels, elemsize, 1, opt.blob_vkallocator);
+    if (top_blob.empty())
+        return -100;
+
+    std::vector<VkMat> bindings(3);
+    bindings[0] = bottom_blob;
+    bindings[1] = grid;
+    bindings[2] = top_blob;
+
+    std::vector<vk_constant_type> constants(9);
+    constants[0].i = bottom_blob.w;
+    constants[1].i = bottom_blob.h;
+    constants[2].i = channels;
+    constants[3].i = bottom_blob.cstep;
+    constants[4].i = grid.w;
+    constants[5].i = grid.cstep;
+    constants[6].i = top_blob.w;
+    constants[7].i = top_blob.h;
+    constants[8].i = top_blob.cstep;
+
+    cmd.record_pipeline(pipeline_gridsample, bindings, constants, top_blob);
+
+    return 0;
+}
+
+} // namespace ncnn
