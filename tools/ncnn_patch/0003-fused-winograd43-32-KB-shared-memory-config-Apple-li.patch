+++ b/src/gpu.cpp
@@ -113,6 +113,15 @@ static uint64_t fnv1a_64_update(uint64_t h, const unsigned char* data, int size)
     return h;
 }
 
+std::string get_layer_shader_source(int shader_type_index)
+{
+    if (shader_type_index < 0 || shader_type_index >= layer_shader_registry_entry_count)
+        return std::string();
+
+    const layer_shader_registry_entry& entry = layer_shader_registry[shader_type_index];
+    return std::string(entry.comp_data, entry.comp_data_size);
+}
+
 uint64_t get_shader_source_hash(int shader_type_index)
 {
     if (shader_type_index < 0 || shader_type_index >= layer_shader_registry_entry_count)
