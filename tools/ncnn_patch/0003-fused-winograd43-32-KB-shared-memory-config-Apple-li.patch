-        // measured faster than ncnn's coopmat winograd on every GPU tried (RX 9070 XT 1.33 vs 1.97 ms,
-        // RTX 4090 0.56 vs 0.93 ms), so it is the default everywhere; NCNN_WINO_FUSED=0 reverts.
+        // measured faster than ncnn's coopmat winograd on every desktop GPU tried (RX 9070 XT 1.33 vs
+        // 1.97 ms, RTX 4090 0.56 vs 0.93 ms, RX 6900 XT 0.88 vs 2.75 ms), so it is the default there;
+        // NCNN_WINO_FUSED=0 reverts. Apple GPUs (MoltenVK) run it SLOWER than ncnn's stock path
+        // (M2 Pro: -30%), so they keep the stock path unless NCNN_WINO_FUSED=2 forces it.
         // Narrow inputs (< 16 ch) stay on the coopmat gemm where one exists (faster and exact there).
-        (void)env_force;
-        use_winograd43_fused = env_ok && (num_input >= 16 || !cm)
+        const bool apple = vkdev->info.vendor_id() == 0x106B;
+        use_winograd43_fused = env_ok && (!apple || env_force) && (num_input >= 16 || !cm)
                                && opt.use_winograd_convolution && opt.use_winograd43_convolution && is_conv3x3s1d1
                                && elempack == 4 && out_elempack == 4 && num_output <= 64
                                && pad_left == 1 && pad_right == 1 && pad_top == 1 && pad_bottom == 1
@@ -609,9 +611,44 @@ int Convolution_vulkan::create_pipeline(const Option& opt)
                 }
                 for (int i = 0; i < 8; i++) specializations[7 + i].i = 0;   // shapes via push constants
 
-                pipeline_convolution_3x3s1d1_winograd43_fused = new Pipeline(vkdev);
-                pipeline_convolution_3x3s1d1_winograd43_fused->set_local_size_xyz(512, 1, 1);
-                pipeline_convolution_3x3s1d1_winograd43_fused->create(LayerShaderType::convolution_pack4_3x3s1d1_winograd43_fused, opt, specializations);
+                // shared-memory config: (16 ic per chunk, 8 oc quads per output pass) = 55 KB, or
+                // (8, 4) = 27.6 KB. The small one is required where maxComputeSharedMemorySize is 32 KB
+                // (Apple/MoltenVK) and is also faster on GPUs without cooperative matrix (RX 6900 XT
+                // 1.01 -> 0.89 ms: twice the workgroups per WGP); coopmat-class GPUs prefer the large
+                // one (RX 9070 XT 1.35 vs 1.66 ms). NCNN_WINO_LDS=32|64 overrides.
+                const uint32_t lds_max = vkdev->info.max_shared_memory_size();
+                const char* lds_env = getenv("NCNN_WINO_LDS");
+                bool small_lds = lds_max < 36u * 16u * 16u * 2u + 36u * 16u * 8u * 8u || !vkdev->info.support_cooperative_matrix();
+                if (lds_env && lds_env[0] == '3') small_lds = true;
+                if (lds_env && lds_env[0] == '6' && lds_max >= 36u * 16u * 16u * 2u + 36u * 16u * 8u * 8u) small_lds = false;
+                int ret = -1;
+                if (lds_max >= 36u * 16u * 8u * 2u + 36u * 16u * 4u * 8u && vkdev->info.max_workgroup_invocations() >= 512)
+                {
+                    // the .comp defaults to the large config; the small one is selected by #defines
+                    // injected after the #version line (ncnn's option defines go in via the preamble)
+                    std::string src = ncnn::get_layer_shader_source(LayerShaderType::convolution_pack4_3x3s1d1_winograd43_fused);
+                    if (small_lds)
+                    {
+                        size_t nl = src.find('\n');
+                        if (nl != std::string::npos)
+                            src.insert(nl + 1, "#define WINO_ICC 8\n#define WINO_OCH 4\n");
+                    }
+                    std::vector<uint32_t> spirv;
+                    if (compile_spirv_module(src.c_str(), (int)src.size(), opt, spirv) == 0)
+                    {
+                        pipeline_convolution_3x3s1d1_winograd43_fused = new Pipeline(vkdev);
+                        pipeline_convolution_3x3s1d1_winograd43_fused->set_local_size_xyz(512, 1, 1);
+                        ret = pipeline_convolution_3x3s1d1_winograd43_fused->create(spirv.data(), spirv.size() * 4, specializations);
+                    }
+                }
+                if (ret != 0)
+                {
+                    NCNN_LOGE("fused winograd43 pipeline unavailable (lds max %u), using the 3-kernel path", lds_max);
+                    delete pipeline_convolution_3x3s1d1_winograd43_fused;
+                    pipeline_convolution_3x3s1d1_winograd43_fused = 0;
+                    use_winograd43_fused = false;
+                    weight_winograd43_fused_data.release();
+                }
             }
         }
 
